# Backend Environment Variables (place in server/.env)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mern_auth_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional SMTP Settings (leave empty to use automated Ethereal testing account)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="MERN Auth System" <no-reply@mernauth.dev>

# Frontend Environment Variables (optional, defaults to http://localhost:5000/api in client/src/services/api.js)
VITE_API_URL=http://localhost:5000/api
