PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mern_auth_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional custom SMTP credentials (e.g. Gmail App Password, Mailtrap, or SendGrid)
# If left blank, Nodemailer generates an automated Ethereal test inbox and prints preview links
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="MERN Auth System" <no-reply@mernauth.dev>
